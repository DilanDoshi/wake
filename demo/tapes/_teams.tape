# Groups the staged fleet into teams, off camera. Sourced inside a Hide by any
# beat that films the fleet already sorted: backend (maya, nora, alex),
# frontend (omar, priya), docs (luca).
Set TypingSpeed 8ms
Type "/team @maya backend"
Enter
Sleep 900ms
Type "/team @nora backend"
Enter
Sleep 900ms
Type "/team @alex backend"
Enter
Sleep 900ms
Type "/team @omar frontend"
Enter
Sleep 900ms
Type "/team @priya frontend"
Enter
Sleep 900ms
Type "/team @luca docs"
Enter
Sleep 1500ms
Set TypingSpeed 55ms
